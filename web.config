<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".f32" /><mimeMap fileExtension=".f32" mimeType="application/octet-stream" />
      <remove fileExtension=".u8" /><mimeMap fileExtension=".u8" mimeType="application/octet-stream" />
      <remove fileExtension=".u16" /><mimeMap fileExtension=".u16" mimeType="application/octet-stream" />
      <remove fileExtension=".bin" /><mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <remove fileExtension=".glb" /><mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
